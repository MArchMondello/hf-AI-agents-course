# .env.example — the NAMES of the secrets this repo uses, never the values.
# Copy it to .env (in this folder or in any parent folder: load_dotenv() searches upwards),
# then fill in the values in your editor. .env is git-ignored; this file is committed.
# Format: NAME=value   (no spaces around =, no quotes needed). See brain/0.8-CS-env-secrets.md

# --- 1. Hugging Face (hf.co/settings/tokens) ---
# "Read" token: downloads, the course's InferenceClient examples (BACKEND = "HF")
HF_TOKEN_READ=
# Fine-grained token with "Make calls to Inference Providers" (smolagents' InferenceClientModel)
HF_TOKEN_INFERENCE=
# Fine-grained token that can only open pull requests and comment on public repos (upstream fixes)
HF_TOKEN_CONTRIB=
# Fine-grained token with Write on ONE Space only (Repositories permissions, not User permissions): deploys
HF_TOKEN_SPACE_WRITE=

# --- 2. Anthropic (console.anthropic.com > API Keys; needs API credit) ---
ANTHROPIC_API_KEY=

# --- 3. Code sandboxes (later, see brain/1.5-CS-sandbox-approaches.md) ---
# E2B_API_KEY=
